{
  "id": "/",
  "name": "Orbit — Social directory",
  "short_name": "Orbit",
  "description": "A directory of social networks, messaging apps and creator tools.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#f6f5f1",
